# 复制本文件为 .env（本地开发用），部署时在 Railway 的 Variables 里配置同名变量。
# 切勿把真实密钥提交到 GitHub。

# 访问密码（必填，登录保护）。不设置则任何人拿到网址都能直接看到客户资料。
APP_PASSWORD=请设置一个只有你知道的密码

# OpenAI 兼容接口（用于每个客户里的 AI 运营助手）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# 可选：使用其他 OpenAI 兼容服务时填写，默认 https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 数据存储：
# 1) 不设置 DATABASE_URL —— 使用本地 JSON 文件（适合本地开发/测试）。
# 2) 设置 DATABASE_URL —— 使用 PostgreSQL（生产环境强烈建议，重启不丢数据）。
#    Railway 上挂一个 PostgreSQL 插件，然后用引用变量，例如：
#    DATABASE_URL=${{Postgres.DATABASE_URL}}
#    PGSSLMODE=no-verify
DATABASE_URL=
PGSSLMODE=

# 本地 JSON 文件路径（默认 ./data/crm.json）。Railway 用 PostgreSQL 时无需设置。
# DATA_FILE=./data/crm.json

# 服务端口（Railway 会自动注入 PORT，无需手动设置）
# PORT=3000
