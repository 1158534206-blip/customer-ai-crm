# 软件访问密码（建议生产环境一定设置）
APP_PASSWORD=请改成你自己的强密码

# DeepSeek API（OpenAI 兼容的 Chat Completions 接口）
DEEPSEEK_API_KEY=
# deepseek-chat = DeepSeek-V3 对话模型；deepseek-reasoner = DeepSeek-R1 推理模型
DEEPSEEK_MODEL=deepseek-chat
# 一般不用改；如使用代理/中转可改成对应地址
DEEPSEEK_API_URL=https://api.deepseek.com

# Railway PostgreSQL 一般会自动提供 DATABASE_URL
DATABASE_URL=

# 如果不用 PostgreSQL，可把 JSON 文件放在持久化卷
DATA_FILE=./data/crm.json

# 某些数据库环境需要关闭 SSL 时才设置
# PGSSL=disable
